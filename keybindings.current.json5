// Klecks key settings (JSON5). Edit and import in Settings.
// onPress: execute; whileHeld: hold tool/modifier; onGesture: mouse/touch controls.
// [] disables an action; omitted actions use defaults. Duplicate onPress keys are rejected.
// Browser/OS-reserved shortcuts may not reach the app.
{
  "onPress": {
    "fitView": [
      "Home"
    ],
    "resetView": [
      "End"
    ],
    "undo": [
      "Ctrl+Z",
      "Cmd+Z"
    ],
    "redo": [
      "Ctrl+Y",
      "Cmd+Y",
      "Ctrl+Shift+Z",
      "Cmd+Shift+Z"
    ],
    "save": [
      "Ctrl+S",
      "Cmd+S"
    ],
    "saveProject": [
      "Ctrl+S+Shift",
      "Cmd+S+Shift"
    ],
    "copy": [
      "C+Ctrl",
      "C+Cmd"
    ],
    "preventNativeSelectAll": [
      "A+Ctrl",
      "A+Cmd"
    ],
    "decreaseBrushSize": [
      "["
    ],
    "increaseBrushSize": [
      "]"
    ],
    "fillLayer": [
      "Enter"
    ],
    "cancel": [
      "Escape"
    ],
    "clearLayer": [
      "Delete",
      "Backspace"
    ],
    "advancedMerge": [
      "Ctrl+E+Shift",
      "Cmd+E+Shift"
    ],
    "toggleEraser": [
      "E+Shift"
    ],
    "eraserBrush": [
      "E"
    ],
    "nextBrush": [
      "B"
    ],
    "handTool": [
